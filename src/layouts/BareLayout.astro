---
/**
 * plan 页专用孤岛 layout：只加载逐字移植的 plan.css，不碰主题层。
 *
 * 为什么必须隔离：主题的 Tailwind preflight（* { margin:0; padding:0; border:0 }
 * + html { line-height:1.5 }）会当场摧毁 plan 页的排版，而 plan 页有一份
 * 「.wrap 内 1154 个元素的 tag/class + 文本 + getBoundingClientRect 全等」的保真基线。
 * 这里因此不引 global.css、不引任何组件，只重复旧 Layout 里 plan 页需要的那几件事。
 *
 * 浅色单主题是有意为之：深色适配要复制 theme.css 里 130 行补丁，收益不值这个复杂度。
 */
import '../styles/plan.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1a1a2e" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content="zh_CN" />
  </head>
  <body>
    <a class="home-float" href="/" aria-label="返回首页">← 首页</a>
    <slot />
    <script>
      // 代码复制：给每个 pre 包一层定位容器再挂按钮（pre 自己横向滚动，按钮不能在它里面）。
      // 这段和上一版 Layout 里的逐字一致 —— 注入的 .code-block/.copy-btn 就在 plan 页保真
      // 基线覆盖的 .wrap 里，行为一变基线就废。
      function legacyCopy(text: string) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        document.body.append(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {}
        ta.remove();
        return ok;
      }

      for (const code of document.querySelectorAll('pre > code')) {
        const pre = code.parentElement;
        if (!pre || pre.closest('.code-block')) continue;
        const box = document.createElement('div');
        box.className = 'code-block';
        pre.replaceWith(box);
        box.append(pre);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '复制';
        btn.setAttribute('aria-label', '复制这段代码');
        let timer: ReturnType<typeof setTimeout>;
        btn.addEventListener('click', async () => {
          const text = code.textContent ?? '';
          let ok: boolean;
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            ok = legacyCopy(text);
          }
          btn.dataset.state = ok ? 'done' : 'fail';
          btn.textContent = ok ? '已复制' : '复制失败';
          clearTimeout(timer);
          timer = setTimeout(() => {
            delete btn.dataset.state;
            btn.textContent = '复制';
          }, 1600);
        });
        box.append(btn);
      }
    </script>
  </body>
</html>

<style is:global>
  /* plan.css 只给到它自己用到的变量；.home-float 用的这几个在旧 theme.css 里定义，
     现在随布局一起搬过来（浅色值，固定）。--orange / --line 由 plan.css 提供。 */
  :root {
    --font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC',
      'Source Han Sans SC', 'Microsoft YaHei', sans-serif;
    --chip-bg: #ffffff;
    --chip-ink: #374151;
    --link-ink: #c2410c;
    --shadow-1: 0 1px 4px rgba(26, 26, 46, 0.05);
    --shadow-2: 0 2px 12px rgba(26, 26, 46, 0.06);
  }

  /* 代码复制：pre 外包一层定位容器，按钮不随横向滚动跑掉。
     这些规则原本在 theme.css 里，随孤岛一起搬过来 —— 少了它们 .copy-btn 会掉回
     静态流内，plan 页的几何基线立刻不成立 */
  .code-block {
    position: relative;
  }
  .code-block > pre {
    padding-right: 66px;
  }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.12);
    color: #e8e8f2;
    border: 1px solid rgba(255, 255, 255, 0.2);
    opacity: 0.5;
    transition:
      opacity 0.15s,
      background 0.15s;
  }
  .code-block:hover .copy-btn,
  .copy-btn:focus-visible {
    opacity: 1;
  }
  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .copy-btn[data-state='done'] {
    opacity: 1;
    background: rgba(46, 196, 182, 0.3);
    border-color: rgba(90, 226, 210, 0.55);
    color: #d9fff8;
  }
  .copy-btn[data-state='fail'] {
    opacity: 1;
    background: rgba(229, 72, 77, 0.32);
    border-color: rgba(255, 150, 150, 0.55);
    color: #ffe3e3;
  }
  @media (hover: none) {
    .copy-btn {
      opacity: 1;
    }
  }

  /* 返回首页入口：position:fixed，不参与文档流 —— plan 页的 rect / scrollHeight
     因此不受影响，也不需要布局占位 */
  .home-float {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 45;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    color: var(--chip-ink);
    background: var(--chip-bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 14px;
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      box-shadow 0.16s ease;
  }
  @media (hover: hover) {
    .home-float:hover {
      color: var(--link-ink);
      border-color: var(--orange);
      box-shadow: var(--shadow-2);
    }
  }
  @media (max-width: 640px) {
    .home-float {
      left: 10px;
      bottom: 10px;
      padding: 8px 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-float {
      transition: none;
    }
  }
  @media print {
    .copy-btn,
    .home-float {
      display: none;
    }
  }
</style>
