---
import Layout from '~/layouts/Layout.astro'
import PageHeader from '~/components/PageHeader.astro'
import BlockHeader from '~/components/BlockHeader.astro'
import PostPreview from '~/components/PostPreview.astro'
import Pagination from '~/components/Pagination.astro'
import { getSortedPosts } from '~/utils'

const posts = await getSortedPosts()
// 最新在前
const latest = [...posts].reverse().slice(0, 3)

const entries = [
  {
    tag: '计划',
    href: '/plan/',
    title: '哑铃减脂完整计划',
    desc: '男 · 29岁 · 172cm / 72kg · 零基础 · 极小空间 · 一对可调哑铃（总重 30kg）',
    more: '饮食方案 · 热身 · 训练 A/B · 小空间有氧 · 一周安排 · 重量对照 · 进度追踪',
  },
  {
    tag: '笔记',
    href: '/notes/',
    title: 'Java 面试笔记',
    desc: '按 P0 / P1 十四天复习计划组织的 Java 面试笔记，含章节目录与学习进度',
    more: 'Java 基础 · 集合 · 并发 · Spring · MySQL · Redis · Kafka · JVM',
  },
]
---

<Layout
  description="哑铃减脂完整计划（172cm / 72kg 零基础，含饮食方案、热身、训练 A/B、小空间有氧、一周安排、重量对照、进度追踪），Java 面试笔记，以及后续的博客文章。"
>
  <div class="max-w-full py-7.5">
    <PageHeader title="训练与减脂笔记" />

    <p class="my-5 text-base/7 text-foreground">
      哑铃减脂完整计划、Java 面试笔记，以及后续的博客文章
    </p>

    <div class="flex flex-col gap-4 my-6">
      {
        entries.map((e) => (
          <a
            class="block rounded-xl border-1 border-foreground/8 bg-foreground/3 p-5 transition-colors hover:border-accent/40 hover:bg-accent/6"
            href={e.href}
          >
            <span class="inline-block rounded-lg bg-foreground/8 text-foreground text-xs px-2 py-1">
              {e.tag}
            </span>
            <h2 class="mt-3 text-xl text-heading2 font-semibold">{e.title}</h2>
            <p class="mt-2 text-sm/6 text-foreground">{e.desc}</p>
            <span class="mt-3 block text-xs/6 text-foreground">{e.more} →</span>
          </a>
        ))
      }
    </div>

    {
      latest.length > 0 && (
        <section class="mt-10">
          <BlockHeader>最近更新</BlockHeader>
          {latest.map((post) => (
            <PostPreview post={post} />
          ))}
          <Pagination nextLink="/notes/" nextText="全部笔记" />
        </section>
      )
    }
  </div>
</Layout>
