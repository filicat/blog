---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const day = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
	title="训练与减脂笔记"
	description="哑铃减脂完整计划（172cm / 72kg 零基础，含饮食方案、热身、训练 A/B、小空间有氧、一周安排、重量对照、进度追踪），以及后续的博客文章。"
>
	<div class="wrap">
		<div class="hero">
			<h1>训练与减脂笔记</h1>
			<p>哑铃减脂完整计划，以及后续的博客文章</p>
		</div>

		<a class="entry" href="/plan/">
			<span class="tag">计划</span>
			<h2>哑铃减脂完整计划</h2>
			<p>男 · 29岁 · 172cm / 72kg · 零基础 · 极小空间 · 一对可调哑铃（总重 30kg）</p>
			<span class="more">饮食方案 · 热身 · 训练 A/B · 小空间有氧 · 一周安排 · 重量对照 · 进度追踪 →</span>
		</a>

		{posts.length > 0 && (
			<section>
				<h2 class="list">文章</h2>
				{posts.map((post) => (
					<a class="entry" href={`/blog/${post.id}/`}>
						<time datetime={day(post.data.date)}>{day(post.data.date)}</time>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</a>
				))}
			</section>
		)}
	</div>
</Layout>

<style>
	.entry {
		display: block;
		background: var(--card);
		border-radius: 18px;
		padding: 22px 24px;
		margin-bottom: 20px;
		box-shadow: 0 2px 12px rgba(26, 26, 46, 0.06);
		border-top: 4px solid var(--orange);
		text-decoration: none;
		color: inherit;
	}
	.entry:active {
		opacity: 0.85;
	}
	.entry h2 {
		font-size: 19px;
		margin: 8px 0 6px;
	}
	.entry h3 {
		font-size: 17px;
		margin: 6px 0;
		line-height: 1.45;
	}
	.entry p {
		font-size: 13.5px;
		color: #4b5563;
	}
	.entry time {
		font-size: 12px;
		color: var(--gray);
	}
	.entry .tag {
		display: inline-block;
		font-size: 11px;
		font-weight: 600;
		background: var(--orange-soft);
		color: #c2410c;
		border-radius: 20px;
		padding: 3px 11px;
	}
	.entry .more {
		display: block;
		margin-top: 10px;
		font-size: 12px;
		color: var(--gray);
	}
	.list {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.5px;
		color: var(--gray);
		margin: 30px 0 14px;
		padding-left: 4px;
	}
</style>
