---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const day = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
	title="训练与减脂笔记"
	description="哑铃减脂完整计划（172cm / 72kg 零基础，含饮食方案、热身、训练 A/B、小空间有氧、一周安排、重量对照、进度追踪），Java 面试笔记，以及后续的博客文章。"
>
	<div class="wrap">
		<div class="hero">
			<h1>训练与减脂笔记</h1>
			<p>哑铃减脂完整计划、Java 面试笔记，以及后续的博客文章</p>
		</div>

		<a class="entry" href="/plan/">
			<span class="tag">计划</span>
			<h2>哑铃减脂完整计划</h2>
			<p>男 · 29岁 · 172cm / 72kg · 零基础 · 极小空间 · 一对可调哑铃（总重 30kg）</p>
			<span class="more">饮食方案 · 热身 · 训练 A/B · 小空间有氧 · 一周安排 · 重量对照 · 进度追踪 →</span>
		</a>

		<a class="entry" href="/notes/">
			<span class="tag">笔记</span>
			<h2>Java 面试笔记</h2>
			<p>按 P0 / P1 十四天复习计划组织的 Java 面试笔记，含章节目录与学习进度</p>
			<span class="more">Java 基础 · 集合 · 并发 · Spring · MySQL · Redis · Kafka · JVM →</span>
		</a>

		{posts.length > 0 && (
			<section>
				<h2 class="list">文章</h2>
				{posts.map((post) => (
					<a class="entry" href={`/blog/${post.id}/`}>
						<time datetime={day(post.data.date)}>{day(post.data.date)}</time>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</a>
				))}
			</section>
		)}
	</div>
</Layout>

<style>
	.entry {
		display: block;
		font-family: var(--font-sans);
		background: var(--card);
		border-radius: 18px;
		padding: 22px 24px;
		margin-bottom: 20px;
		box-shadow: var(--shadow-2);
		border-top: 4px solid var(--orange);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.16s ease,
			box-shadow 0.16s ease;
	}
	.entry:active {
		opacity: 0.85;
	}
	/* 悬浮只在真能悬浮的设备上抬卡片；关掉动效偏好时不位移，只换阴影 */
	@media (hover: hover) {
		.entry:hover {
			box-shadow: var(--shadow-3);
		}
	}
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.entry:hover {
			transform: translateY(-2px);
		}
	}
	.entry h2 {
		font-size: 21px;
		margin: 8px 0 6px;
	}
	.entry h3 {
		font-size: 18px;
		margin: 6px 0;
		line-height: 1.45;
	}
	.entry p {
		font-size: 14.5px;
		line-height: 1.7;
		color: var(--ink-3);
	}
	.entry time {
		font-size: 12.5px;
		color: var(--gray);
	}
	.entry .tag {
		display: inline-block;
		font-size: 11.5px;
		font-weight: 600;
		background: var(--orange-soft);
		color: var(--link-ink);
		border-radius: 20px;
		padding: 3px 11px;
	}
	.entry .more {
		display: block;
		margin-top: 10px;
		font-size: 12.5px;
		line-height: 1.6;
		color: var(--gray);
	}
	.list {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.5px;
		color: var(--gray);
		margin: 30px 0 14px;
		padding-left: 4px;
	}
</style>
