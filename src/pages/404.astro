---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 · 哑铃减脂完整计划" noindex>
  <div class="wrap notfound">
    <p class="code">404</p>
    <h1>这个页面不存在</h1>
    <p class="msg">链接可能写错了，或者页面已经被移走。</p>
    <a class="home" href="/">返回「哑铃减脂完整计划」</a>
  </div>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 24px;
  }
  .code {
    font-size: 76px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 2px;
    color: var(--orange);
  }
  h1 {
    font-size: 22px;
    margin-top: 14px;
  }
  .msg {
    font-size: 14px;
    color: var(--gray);
    margin-top: 6px;
  }
  .home {
    margin-top: 24px;
    display: inline-block;
    background: var(--dark);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 20px;
    padding: 10px 22px;
  }
  .home:active {
    background: var(--orange);
  }
</style>
