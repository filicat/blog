---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 · 哑铃减脂完整计划" noindex>
  <div class="wrap notfound">
    <p class="code">404</p>
    <h1>这个页面不存在</h1>
    <p class="msg">链接可能写错了，或者页面已经被移走。</p>
    <a class="home" href="/">返回「哑铃减脂完整计划」</a>
  </div>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 24px;
    font-family: var(--font-sans);
  }
  .code {
    font-size: 76px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 2px;
    color: var(--orange);
  }
  h1 {
    font-size: 24px;
    margin-top: 14px;
  }
  .msg {
    font-size: 14.5px;
    color: var(--ink-3);
    margin-top: 8px;
  }
  .home {
    margin-top: 24px;
    display: inline-block;
    background: var(--dark);
    color: var(--bg);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 20px;
    padding: 10px 22px;
    box-shadow: var(--shadow-2);
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease;
  }
  /* 反白胶囊在深色下靠 --dark 翻面，底色与文字都走变量，两种主题都过 AA */
  @media (hover: hover) {
    .home:hover {
      box-shadow: var(--shadow-3);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .home:hover {
      transform: translateY(-2px);
    }
  }
  .home:active {
    box-shadow: var(--shadow-1);
  }
</style>
